# Optional overrides. FFmpeg and FFprobe must be installed and available on PATH.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# MAX_UPLOAD_MB=2048
# MAX_REMOTE_MB=2048
# MAX_MEDIA_SECONDS=21600
# MAX_PROCESS_SECONDS=5400
# MAX_CONCURRENT_JOBS=2
# MAX_ACTIVE_JOBS=10
# MAX_ACTIVE_PREVIEWS=3
# PREVIEW_TTL_SECONDS=600
# MAX_OUTPUT_MB=2048
# JOB_TTL_SECONDS=3600
# STORAGE_DIR=storage
# YouTube public metadata is queried through oEmbed; it does not expose media files.
# Meta Graph API is used only for content returned to an authorized account/token.
# META_GRAPH_ACCESS_TOKEN=
# META_GRAPH_API_VERSION=v26.0
# META_INSTAGRAM_ACCESS_TOKEN=
# META_INSTAGRAM_USER_ID=
# META_INSTAGRAM_GRAPH_HOST=graph.facebook.com
# Public extractor adapter. It never loads cookies, passwords, browser profiles, or proxies.
# Only submit media you are allowed to save and process.
# YT_DLP_ENABLED=false
# YT_DLP_TIMEOUT_SECONDS=45
# PARALLEL_THRESHOLD_SECONDS=1200
# PARALLEL_SEGMENT_SECONDS=300
# PARALLEL_WORKERS=2
